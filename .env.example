# PostgreSQL connection string (Neon / Supabase / RDS / local all work)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karya?schema=public"

# 32+ character random string used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Where receipts and product photos are kept.
#   "local"    writes to STORAGE_LOCAL_DIR. Use on a machine with a real disk.
#   "database" stores them in Postgres. Use on serverless hosts (Vercel and
#              similar), whose filesystem is wiped between requests.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Public address of the deployment, e.g. https://karya.example.com
# Only used to build password-reset links from the command line.
# APP_URL="http://localhost:3000"

NODE_ENV="development"
